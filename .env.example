# File cấu hình môi trường (tùy chọn)
# Đổi tên file thành .env và điền key của bạn nếu không muốn nhập thủ công trên giao diện

# 1. Google Gemini API Key (Bắt buộc cho phân tích video & thị giác AI)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. SerpApi API Key (Tùy chọn - Dùng cho tính năng tự động tra cứu Google Lens)
# Đăng ký tại: https://serpapi.com/ (100 lượt tìm kiếm miễn phí/tháng)
SERPAPI_API_KEY=
